<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- To see whether a camera app is there to take a photo (no camera permission is asked). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
    <application
        android:name=".DrawingApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <!-- Keeps the landscape lock honoured on large screens while targeting API 36. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <!-- The canvas is one fixed landscape page; the lock is deliberate (workspace decisions).
             The activity handles configuration changes itself, so a theme or keyboard change does
             not recreate it and drop the page in progress. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|density|fontScale|keyboard|keyboardHidden|navigation|locale|layoutDirection|screenLayout|smallestScreenSize|screenSize|orientation"
            android:exported="true"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,NonResizeableActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DrawingActivity"
            android:configChanges="uiMode|density|fontScale|keyboard|keyboardHidden|navigation|locale|layoutDirection|screenLayout|smallestScreenSize|screenSize|orientation"
            android:exported="false"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,NonResizeableActivity" />
        <activity
            android:name=".ParentActivity"
            android:configChanges="uiMode|density|fontScale|keyboard|keyboardHidden|navigation|locale|layoutDirection|screenLayout|smallestScreenSize|screenSize|orientation"
            android:exported="false"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,NonResizeableActivity" />
        <!-- Lets the camera app write a photo into photos/, and nowhere else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>
    </application>
</manifest>
