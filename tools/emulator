#!/usr/bin/env bash
# Runs a scenario on the emulator service, as the group that owns /dev/kvm on this host.
# Usage: tools/emulator <scenario-script> [args...]
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p build/emulator
KVM_GID=$(stat -c %g /dev/kvm) exec docker compose run --build --rm emulator "$@"
