#!/usr/bin/env bash
# Runs a scenario on the emulator service, as the group that owns /dev/kvm on this host.
# Usage: tools/emulator <scenario-script> [args...]
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p build/emulator
# One run at a time: every run writes its screenshots and log to build/emulator, and a second run
# there would read the first one's captures (it did, once, during a ship).
exec 9>build/emulator/.lock
flock -n 9 || { echo "emulator: another scenario run holds build/emulator; wait for it to finish" >&2; exit 1; }
# The emulator needs about 8 GB of container storage; say so plainly rather than fail mid-boot.
free_gb=$(( $(df --output=avail -k "$(docker info --format '{{.DockerRootDir}}')" | tail -1) / 1048576 ))
[ "$free_gb" -ge 10 ] || { echo "emulator: only ${free_gb} GB free for Docker; need 10 (try: docker builder prune --filter until=30m)" >&2; exit 1; }
KVM_GID=$(stat -c %g /dev/kvm) exec docker compose run --build --rm emulator "$@"
