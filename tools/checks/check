#!/usr/bin/env bash
# The one check command (TC-5): runs inside the check container, offline.
# - Gradle shows only lint's first finding, so every lint report is printed (AG-2).
# - Every build warning fails the check unless allowed by exact text (TS-18).
set -euo pipefail
export LC_ALL=C
cd "$(dirname "$0")/../.."
log=$(mktemp)
status=0
tools/checks/casts || status=1
tools/checks/vendored || status=1
tools/checks/waivers || status=1
tools/checks/keys || status=1
tools/checks/logtags || status=1
tools/checks/scenario-tiles || status=1
tools/checks/backup-rules || status=1
./gradlew --offline --no-daemon --console=plain --warning-mode=all \
  checkAll 2>&1 | tee "$log" || status=$?
[ "$status" -ne 0 ] || tools/checks/apk || status=1
[ "$status" -ne 0 ] || tools/checks/release-cert || status=1
[ "$status" -ne 0 ] || tools/checks/test-inventory || status=1

while IFS= read -r -d '' report; do
  echo "--- lint report: $report ---"
  cat "$report"
done < <(find build -name 'lint-results-*.txt' -print0)

allowed=$(mktemp)
grep -v '^#' tools/checks/allowed-warnings.txt >"$allowed" || true
warnings=$(grep -E 'deprecated|^w: |[Ww]arning:' "$log" | grep -vxF -f "$allowed" || true)
if [ -n "$warnings" ]; then
  echo "--- build warnings not in tools/checks/allowed-warnings.txt ---"
  echo "$warnings"
  [ "$status" -ne 0 ] || status=1
fi
while IFS= read -r want; do
  grep -qxF -- "$want" "$log" || { echo "allowed warning no longer emitted, remove it: $want"; status=1; }
done <"$allowed"
exit "$status"
