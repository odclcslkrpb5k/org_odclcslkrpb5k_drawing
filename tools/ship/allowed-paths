# The paths a ship may add (SH-15): one extended regex per line, starting with ^, holding no
# space, matched byte-wise against each path the ship adds since origin's main.
# tools/ship/commit-and-push reads this list from the tree it ships and refuses an added path that
# no line admits, or a line that is not a valid pattern. A new kind of file is an edit here, in the
# same change, where review sees it.
#
# Files at the root.
^\.dockerignore$
^\.gitignore$
^CLAUDE\.md$
^README\.md$
^LICENSE$
^compose\.yaml$
^build\.gradle\.kts$
^settings\.gradle\.kts$
^gradle\.properties$
^gradle\.lockfile$
^settings-gradle\.lockfile$
^buildscript-gradle\.lockfile$
^gradlew$
# Gradle's wrapper, version catalog and verification metadata.
^gradle/
# Modules: Kotlin and Android resources only, no binaries but the listed kinds.
^(app|core)/build\.gradle\.kts$
^(app|core)/gradle\.lockfile$
^(app|core)/src/(main|test|androidTest)/kotlin/.*\.kt$
^app/src/main/AndroidManifest\.xml$
^app/src/main/res/(drawable|mipmap|values|xml)/[a-z0-9_]+\.xml$
# Tooling, configuration and fixtures.
^config/detekt/detekt\.yml$
^docker/(ship\.)?Dockerfile$
^tools/
^test/ship/
^test/support/
^test-fixtures/
^\.githooks/
