#!/usr/bin/env bash
# Opens a new page and draws three finger strokes back to back, in one shell, so a stroke starts
# before Ink has handed the previous one back; every stroke must then be on the screen's pixels.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
adb shell am start -W -n $pkg/.MainActivity >/dev/null
home_open
tap $NEW_TILE
page_open
adb shell "$(stroke 400 300 1500 400); $(stroke 400 700 1500 800); $(stroke 900 200 1000 1000)"
sleep 2
capture draw-strokes
failed=0
inked 1850 1195 && { echo "scenario: the color rail's bottom padding should be background"; failed=1; }
inked 950 350 || { echo "scenario: stroke 1 missing at (950,350)"; failed=1; }
inked 950 750 || { echo "scenario: stroke 2 missing at (950,750)"; failed=1; }
inked 950 600 || { echo "scenario: stroke 3 missing at (950,600)"; failed=1; }
no_errors
[ "$failed" -eq 0 ] || exit 1
echo "scenario draw-strokes: three strokes on the page"
