#!/usr/bin/env bash
# A stamp: chosen from the tray, placed by a tap, moved by a drag while selected; one undo takes it
# away entirely (the move is part of placing it), redo brings it back where it was moved, and it is
# still there after leaving and reopening the page.
set -euo pipefail
. "$(dirname "$0")/lib.sh"
adb shell am start -W -n $pkg/.MainActivity >/dev/null
home_open
tap $NEW_TILE
page_open
tap $STAMPS_BUTTON
sleep 1
tap $HAPPY_FACE
sleep 1
tap 900 600
sleep 1
capture stamp-placed
inked 900 600 || { echo "scenario: no stamp where it was placed"; exit 1; }
adb shell "$(drag 900 600 1300 850)"
sleep 1
capture stamp-moved
failed=0
inked 1300 850 || { echo "scenario: the stamp did not follow the drag"; failed=1; }
inked 900 600 && { echo "scenario: the stamp is still where it was placed"; failed=1; }
tap $UNDO_BUTTON
sleep 1
capture stamp-undone
inked 1300 850 && { echo "scenario: one undo left the moved stamp"; failed=1; }
inked 900 600 && { echo "scenario: one undo left the stamp where it was placed"; failed=1; }
tap $REDO_BUTTON
sleep 1
# A face can be put down and slid in one motion: it ends where the finger lifts.
tap $STAMPS_BUTTON
sleep 1
tap $SAD_FACE
sleep 1
adb shell "$(drag 600 350 600 750)"
sleep 1
capture stamp-slid
inked 600 750 || { echo "scenario: a face placed and slid in one touch did not follow"; failed=1; }
inked 600 350 && { echo "scenario: a face placed and slid in one touch stayed where it landed"; failed=1; }
# Clip art: the tray's third row starts with the unicorn; it is placed like a face.
tap $STAMPS_BUTTON
sleep 1
capture stamp-tray
tap $UNICORN_STAMP
sleep 1
tap 1500 300
sleep 1
capture stamp-unicorn
# The pink mane: a color no face, pen dot or stroke of the default purple has.
colored 1548 300 240 98 146 || { echo "scenario: no unicorn where it was placed"; failed=1; }
# A stroke after the stamp goes over it, and the eraser rubs it out. The stamp, just placed, is
# still selected (a finger on it would move it), so a small stroke elsewhere lets it go first.
read -r ur ug ub <<<"$(pixel 1548 340)"
[ "$ur" -lt 250 ] || [ "$ug" -lt 250 ] || [ "$ub" -lt 250 ] || { echo "scenario: no unicorn under the eraser's path"; exit 1; }
adb shell "$(stroke 300 1100 340 1100)"
sleep 1
adb shell "$(stroke 1400 300 1680 300)"
sleep 1
capture stamp-marked-over
colored 1548 300 122 75 224 || { echo "scenario: a stroke after the stamp did not go over it"; failed=1; }
tap $BRUSH_BUTTON
sleep 1
tap $ERASER
sleep 1
adb shell "$(stroke 1400 340 1680 340)"
sleep 1
capture stamp-erased
colored 1548 340 255 255 255 || { echo "scenario: the eraser did not rub out the stamp"; failed=1; }
colored 1548 300 122 75 224 || { echo "scenario: the eraser took more than its path"; failed=1; }
adb shell "input tap $HOME_BUTTON"
home_open
capture stamp-home
# The gallery tile shows the moved happy face: page (1352,899) in the tile's thumbnail.
inked_column 1235 220 232 || { echo "scenario: the gallery tile does not show the stamp"; failed=1; }
tap $SAVED_TILE
page_open
capture stamp-reopened
inked 1300 850 || { echo "scenario: the stamp did not survive leaving and reopening"; failed=1; }
colored 1548 300 122 75 224 || { echo "scenario: the stroke over the unicorn did not survive reopening"; failed=1; }
colored 1548 340 255 255 255 || { echo "scenario: the erased part of the unicorn came back on reopening"; failed=1; }
colored 1528 250 240 98 146 || { echo "scenario: the rest of the unicorn did not survive reopening"; failed=1; }
no_errors
[ "$failed" -eq 0 ] || exit 1
echo "scenario stamps: placed, moved, undone as one step, redone, kept; clip art, marked over and erased"
